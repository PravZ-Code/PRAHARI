# ── PRAHARI — Root Environment Configuration ───────────────────────────────
# Used by docker-compose.yml and as the master reference.
# Copy to .env and fill in production values before deploying.
# NEVER commit .env to version control.
# ───────────────────────────────────────────────────────────────────────────

# ── Database ──
# SQLite (zero-config, runs immediately without Docker/PostgreSQL):
DATABASE_URL=sqlite:///./prahari.db
AUTH_DATABASE_URL=sqlite:///./prahari_auth.db

# PostgreSQL (production / multi-user):
# DATABASE_URL=postgresql://prahari:YOUR_STRONG_PASSWORD@localhost:5432/prahari_db
# AUTH_DATABASE_URL=postgresql://prahari:YOUR_STRONG_PASSWORD@localhost:5432/prahari_auth_db
POSTGRES_USER=prahari
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=prahari_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Backend ──
APP_ENV=development
PORT=8000
# CRITICAL: Generate with `openssl rand -hex 32`
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
GATEWAY_SHARED_SECRET=
AIRGAP_SHARED_SECRET=
LEDGER_SIGNING_KEY=

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000/api
BACKEND_URL=http://127.0.0.1:8000
INTERNAL_API_URL=http://127.0.0.1:8000/api

# ── Mobile ──
# Build with: flutter build apk --dart-define=API_BASE_URL=https://api.yourdomain.com/api
API_BASE_URL=http://10.0.2.2:8000/api

# ── AI / LLM (Local Ollama) ──
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:0.6b

# ── Feature Flags ──
RATE_LIMIT_ENABLED=true
ENABLE_SECURITY_HEADERS=true
REQUIRE_ML_ARTIFACTS=true
ALLOW_INSECURE_LOCAL_GATEWAY=false
