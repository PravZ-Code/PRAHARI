# ── PRAHARI Frontend Environment Configuration ──
# Copy to .env.local for local development.
# NEVER commit .env.local to version control.

# Backend API URL (server-side — used by Next.js middleware & proxy)
INTERNAL_API_URL=http://127.0.0.1:8000/api

# Backend API URL (client-side — exposed to browser via NEXT_PUBLIC_ prefix)
# In production: https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Backend root URL (for Next.js rewrite proxy /backend/* → backend)
BACKEND_URL=http://127.0.0.1:8000
