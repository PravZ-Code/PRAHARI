# ── PRAHARI Backend Environment Configuration ──────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ───────────────────────────────────────────────────────────────────────────

# ── Application ──
APP_ENV=development                    # development | staging | production
BUILD_VERSION=1.0.0
PORT=8000                              # Uvicorn listening port

# ── Database ──
# SQLite (single-server / development):
DATABASE_URL=sqlite:///./prahari.db
AUTH_DATABASE_URL=sqlite:///./prahari_auth.db

# PostgreSQL (multi-server / production):
# DATABASE_URL=postgresql://prahari:YOUR_STRONG_PASSWORD@db-host:5432/prahari_db
# AUTH_DATABASE_URL=postgresql://prahari:YOUR_STRONG_PASSWORD@db-host:5432/prahari_auth_db
# POSTGRES_USER=prahari
# POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD
# POSTGRES_DB=prahari_db
# POSTGRES_HOST=db-host
# POSTGRES_PORT=5432

# ── Authentication & Security ──
# CRITICAL: Generate strong keys before deploying!
#   openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Integration secrets (required in production, 32+ chars each):
GATEWAY_SHARED_SECRET=
AIRGAP_SHARED_SECRET=
LEDGER_SIGNING_KEY=
# Welfare-note content encryption KEK — REQUIRED in production, must be distinct
# from LEDGER_SIGNING_KEY (production startup hard-fails otherwise).
WELFARE_NOTE_KEK=

# ── Auth hardening ──
# Just-in-time demo account provisioning with 'demo123'. Hard-disabled in production.
DEMO_AUTOPROVISION_ENABLED=true
# When true, /api/auth/login strictly requires a server-issued captcha.
AUTH_CAPTCHA_REQUIRED=false

# ── Phase-2 novel features ──
# F3 Post-Leave Reintegration Window (days after return from leave)
REINTEGRATION_WINDOW_DAYS=14
# F1 Helper-Load Ledger (burden ledger before helper is removed from replacement pool)
HELPER_BURDEN_THRESHOLD=3.0
HELPER_BURDEN_WINDOW_DAYS=7
HELPER_ENTRY_EXPIRY_DAYS=7
# F5 welfare-note retention window on resolved cases (auto crypto-erasure sweep)
WELFARE_NOTE_RETENTION_DAYS=90
# F2 Mission Risk Budget sign-off thresholds
MISSION_MIN_RESERVE_PCT=15.0
MISSION_MAX_SSAI=0.55
MISSION_MAX_OPEN_CRISIS=5

# ── CORS (comma-separated frontend origins) ──
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# ── AI / LLM (Local Ollama Intelligence Engine) ──
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b

# ── Redis (optional) ──
REDIS_URL=redis://localhost:6379/0

# ── Feature Flags ──
RATE_LIMIT_ENABLED=true
ENABLE_SECURITY_HEADERS=true
REQUIRE_ML_ARTIFACTS=true
MAX_REQUEST_BODY_BYTES=2097152
ALLOW_INSECURE_LOCAL_GATEWAY=false

# ── Monitoring ──
PROMETHEUS_METRICS_KEY=
